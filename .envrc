# Load the flake's default devShell through nix-direnv, which Home Manager
# provides (programs.direnv.nix-direnv in modules/programs/shell.nix).
#
# Uses the Git-backed flake reference rather than `path:.`: the devShell
# needs no untracked files, and `path:.` would copy ignored state (.jj,
# .direnv, result, nested checkouts) into the store on every reload.

# The `ci` command is built from this script via builtins.readFile.
watch_file jj/ci.nu

if [ -e .git ]; then
  use flake
elif [ -e xr-workbench/web/.iwsdk ]; then
  # IWSDK caches a certificate and private key here; `path:.` would copy it
  # into the world-readable Nix store.
  log_error "Not loading the devShell: move xr-workbench/web/.iwsdk out of this workspace first."
else
  # A JJ workspace from `ci start` has no .git of its own, so the Git-backed
  # reference resolves to the parent repository and rejects this
  # workspace's files as untracked. Use `path:.` here, as `ci` does.
  use flake path:.
fi
