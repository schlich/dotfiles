# Every Jev question and threshold used by this repository lives here so they
# can be reviewed and tuned in one place. Thresholds were chosen for the pinned
# model; retune them before moving `model` to a newer release.
{
  model: "jev-1.13.0"
  triage_gate: {
    # Failures of these classes are recorded but do not start an agent.
    skip_classes: [expected_nonzero typo_or_not_found interrupted]
    # A skip also requires a confident class and a low need for diagnosis.
    min_skip_confidence: 0.8
    max_skip_needs_diagnosis: 0.3
    questions: {
      failure_class: {
        type: choice
        instructions: "Which kind of failure is the interactive shell command `command` that exited with `exit_code`?"
        criteria: {
          expected_nonzero: "A probe that reports a negative result by design, such as a search with no matches, a diff that found differences, or a test that checks whether something exists"
          typo_or_not_found: "A misspelled or nonexistent command, subcommand, flag, variable, or path"
          interrupted: "The user cancelled or interrupted the command"
          nix_error: "A Nix evaluation, flake, build, or activation failure"
          vcs_error: "A Jujutsu or Git operation failed, such as a conflict, divergent change, or rejected push"
          build_or_test_failure: "A compiler, linter, formatter, or test runner reported errors"
          network: "A download, API request, remote connection, or authentication to a remote service failed"
          permission: "Access was denied by file permissions, sudo, or a sandbox"
          other: "Any other failure"
        }
      }
      needs_diagnosis: {
        type: noul
        instructions: "The user would need help diagnosing why `command` failed."
        criteria: {
          "true": "The cause is not obvious from the command itself and could take investigation"
          "false": "The cause is obvious or the failure is routine"
        }
      }
    }
  }
  bash_guard: {
    # Jev answers only Choice, Score, and Noul questions; it cannot write a
    # translation. At or above this probability the call is denied so the
    # agent retries in Nushell; below it the user confirms the Bash call.
    min_nushell_rewrite: 0.8
    questions: {
      nushell_rewrite: {
        type: noul
        instructions: "The shell command in `bash_command` is read-only file inspection, searching, listing, or text and data processing (for example pipelines built from cat, grep, rg, sed, awk, find, ls, wc, jq, head, tail, sort, or cut) that an agent could straightforwardly rewrite as an equivalent Nushell pipeline."
        criteria: {
          "true": "The command only reads and transforms files or text, and Nushell's built-in commands can express it directly"
          "false": "The command runs a program for its own behavior or side effects, such as a build, version-control operation, package manager, service, network client, or privileged action, or the rewrite would be uncertain"
        }
      }
    }
  }
  # Claude Code permission dialogs; thresholds and class tiers live in
  # modules/tooling/ai/trust-policy.nuon.
  route: {
    questions: {
      action_class: {
        type: choice
        instructions: "Which kind of action is the agent tool call `tool_name` with arguments `input`, run in `cwd`?"
        criteria: {
          read_only: "Only inspects files, status, logs, history, documentation, or search results and changes nothing"
          local_edit: "Creates or edits files inside a version-controlled working copy, where the change can be undone"
          local_vcs: "A local Jujutsu or Git operation that does not contact a remote, such as describe, new, commit, split, squash, or rebase"
          validation: "Formats, lints, evaluates, tests, or builds without activating or deploying the result"
          publish: "Pushes a topic branch or updates a review, such as publishing a pull request, without changing the main branch"
          deliver: "Lands or merges into the main branch, tags a release, or deploys"
          system_change: "Changes the running system: activation, privileged commands, services, system packages, or files outside a version-controlled working copy"
          external_message: "Sends or changes something other people or external accounts see, such as mail, calendar events, issues, or comments"
          destructive: "Deletes or overwrites data that version control cannot restore"
          other: "Anything else"
        }
      }
      needs_user_intent: {
        type: noul
        instructions: "Deciding whether the tool call `tool_name` with arguments `input` should run requires the user's own preference or intent, rather than facts that repository files, documentation, tool output, or another agent could settle."
        criteria: {
          "true": "The right answer depends on what the user wants, such as scope, naming, trade-offs, timing, or whether to do the task at all"
          "false": "The call is a routine step whose correctness is a matter of fact, such as reading, formatting, or validating"
        }
      }
    }
  }
}
