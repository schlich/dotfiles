# Every Jev question and threshold used by this repository lives here so they
# can be reviewed and tuned in one place. Thresholds were chosen for the pinned
# model; retune them before moving `model` to a newer release.
{
  model: "jev-1.13.0"
  triage_gate: {
    # Failures of these classes are recorded but do not start an agent.
    skip_classes: [expected_nonzero typo_or_not_found interrupted]
    # A skip also requires a confident class and a low need for diagnosis.
    min_skip_confidence: 0.8
    max_skip_needs_diagnosis: 0.3
    questions: {
      failure_class: {
        type: choice
        instructions: "Which kind of failure is the interactive shell command `command` that exited with `exit_code`?"
        criteria: {
          expected_nonzero: "A probe that reports a negative result by design, such as a search with no matches, a diff that found differences, or a test that checks whether something exists"
          typo_or_not_found: "A misspelled or nonexistent command, subcommand, flag, variable, or path"
          interrupted: "The user cancelled or interrupted the command"
          nix_error: "A Nix evaluation, flake, build, or activation failure"
          vcs_error: "A Jujutsu or Git operation failed, such as a conflict, divergent change, or rejected push"
          build_or_test_failure: "A compiler, linter, formatter, or test runner reported errors"
          network: "A download, API request, remote connection, or authentication to a remote service failed"
          permission: "Access was denied by file permissions, sudo, or a sandbox"
          other: "Any other failure"
        }
      }
      needs_diagnosis: {
        type: noul
        instructions: "The user would need help diagnosing why `command` failed."
        criteria: {
          "true": "The cause is not obvious from the command itself and could take investigation"
          "false": "The cause is obvious or the failure is routine"
        }
      }
    }
  }
  # `deploy-reverts causes`: why a staged switch reverted, read from its
  # report, and whether a check before deployment could have caught it.
  deploy_reverts: {
    # Characters of each report sent; the journal excerpt is the tail.
    max_report_chars: 6000
    min_confidence: 0.6
    # A revert counts as catchable at or above this probability.
    min_catchable: 0.6
    questions: {
      cause: {
        type: choice
        instructions: "What caused the staged NixOS switch in `revert` to revert or be rejected? `revert.phase` is where it stopped, `revert.breached` the health probes that tripped, and `revert.report` the report the watch wrote."
        criteria: {
          evaluation_or_build: "The configuration failed to evaluate or build, so nothing was activated"
          service_failure: "A system service failed to start or crashed after activation because of its configuration or package"
          restart_loop: "A unit kept restarting after activation"
          network_or_ssh: "Networking, DNS, the firewall, or SSH access broke after activation"
          resource_exhaustion: "Disk, memory, or another resource ran out during the build or after activation"
          external_dependency: "A remote service, cache, or substituter the switch depends on was unavailable"
          flaky_probe: "The health probe itself misfired or timed out while the system was healthy"
          other: "Anything else, or the report does not say"
        }
      }
      precheck_catchable: {
        type: noul
        instructions: "A check run before deployment, such as a flake check, an evaluation assertion, or a NixOS VM test, could have caught what made the switch in `revert` fail."
        criteria: {
          "true": "The failure follows from the configuration itself and would show up in evaluation, a build, or a VM test"
          "false": "The failure depends on the live host, its data, the network, or a transient condition"
        }
      }
    }
  }
  # `luvus-deliver`: how risky delivering luvus/integration to main is. Code
  # works out which hosts each changed file reaches, from Den
  # (tools/den-reach.nix) and the files that import it, and decides; Jev
  # judges what the change does. A high-risk delivery waits for the owner to
  # approve that exact commit (`luvus-deliver --approve REV`).
  delivery_risk: {
    # Characters of the diff sent: each file's share, then the whole.
    max_file_diff_chars: 2000
    max_diff_chars: 12000
    # At or above this probability, a change to boot or storage, secrets or
    # keys, or access needs the owner's approval.
    min_concern: 0.5
    # At or above this breakage score, out of 4, the delivery needs it too.
    max_breakage: 3.5
    # A delivery that reaches several deployed hosts needs approval once its
    # breakage score reaches this: 2 is a desktop app or user service, 3 a
    # system service, networking, or the delivery pipeline. 0 makes every
    # change to several hosts wait for approval.
    several_hosts_min_breakage: 2.5
    # Changed paths that always need approval, whatever Jev says: secrets,
    # the host-local hardware, storage, and key files, and the ruleset that
    # gates main.
    approval_paths: ['^secrets/' '^hosts/' '^\.github/rulesets/']
    # Named in the diff Jev reads, without their contents.
    hidden_paths: ['^secrets/' '\.age$' '(^|/)flake\.lock$' '(^|/)(pnpm-lock\.yaml|package-lock\.json|Cargo\.lock)$']
    # Documentation is named without its contents too: prose about access or
    # storage would read as a change to it.
    prose_paths: ['\.md$']
    context: "`delivery` is a set of commits about to be delivered to main of a personal NixOS flake that configures its owner's machines. Once main moves, homelab, an always-on server that serves the fleet's binary cache and runs its CI, stages its new system within minutes, and the owner's laptop, asus, switches right after. Each entry of `delivery.files` lists the hosts whose NixOS system (`systems`) and whose Home Manager home (`homes`) that file reaches through the configuration's imports; empty lists mean no host runs it, as for documentation, tests, CI, and agent instructions. Only nixbot's checks, which the ruleset in `.github/rulesets/` requires, gate main; GitHub Actions workflows report without gating anything. `delivery.diff` is the unified diff, clipped, without secrets. The answers decide whether the owner must approve the delivery before it lands or can review it afterwards."
    questions: {
      boot_storage: {
        type: noul
        instructions: {
          question: "The change in `delivery.diff` alters how a host boots or keeps its data."
          covers: ["the bootloader, kernel, or initrd" "disks, partitions, filesystems, or mounts" "swap" "what persists across reboots (impermanence)" "hardware configuration"]
          not_for: ["the Nix store, binary caches, or garbage collection" "documentation, comments, or messages that mention these"]
        }
        criteria: {
          "true": "A changed line sets or alters one of these, in a host's own files or in a module that hosts import"
          "false": "No changed line does"
        }
      }
      secrets_keys: {
        type: noul
        instructions: {
          question: "The change in `delivery.diff` alters secrets or keys."
          covers: ["encrypted secret files and who can decrypt them" "disk encryption" "SSH host or user keys" "signing keys" "API tokens" "certificates"]
          not_for: ["documentation, comments, or messages that mention secrets or keys"]
        }
        criteria: {
          "true": "A changed line adds, removes, moves, or re-encrypts a secret or key, or changes who or what may read one"
          "false": "No changed line does"
        }
      }
      access: {
        type: noul
        instructions: {
          question: "The change in `delivery.diff` alters who or what may reach or control a host, or which checks main requires before it accepts a commit."
          covers: ["SSH or login access" "users and groups" "sudo or polkit rules" "firewall rules or listening ports" "Tailscale serve or funnel" "a service's privileges or sandboxing" "the binary caches and signing keys a host trusts to supply software" "the required checks or branch rules that gate main"]
          not_for: ["what CI builds, caches, or keeps" "garbage collection or build scheduling" "documentation, comments, or messages that mention access"]
        }
        criteria: {
          "true": "A changed line grants, removes, or widens such access, or changes which checks main requires"
          "false": "No changed line does"
        }
      }
      breakage: {
        type: score
        instructions: "If the change in `delivery` is wrong, how badly could it break the hosts that `delivery.files` says it reaches?"
        criteria: [
          "Nothing a host runs changes: only documentation, comments, tests, CI, or agent instructions"
          "One command, script, or tool misbehaves until it is fixed"
          "A desktop app, the desktop session, or a user service fails"
          "A system service, networking, remote access, or the build and delivery pipeline fails"
          "A host fails to boot, loses data, or locks its owner out"
        ]
      }
    }
  }
  bash_guard: {
    # Jev answers only Choice, Score, and Noul questions; it cannot write a
    # translation. At or above this probability the call is denied so the
    # agent retries in Nushell; below it the user confirms the Bash call.
    min_nushell_rewrite: 0.8
    questions: {
      nushell_rewrite: {
        type: noul
        instructions: "The shell command in `bash_command` is read-only file inspection, searching, listing, or text and data processing (for example pipelines built from cat, grep, rg, sed, awk, find, ls, wc, jq, head, tail, sort, or cut) that an agent could straightforwardly rewrite as an equivalent Nushell pipeline."
        criteria: {
          "true": "The command only reads and transforms files or text, and Nushell's built-in commands can express it directly"
          "false": "The command runs a program for its own behavior or side effects, such as a build, version-control operation, package manager, service, network client, or privileged action, or the rewrite would be uncertain"
        }
      }
    }
  }
  # `claude-bash-audit report --jev`: the bash-feedback skill's remedy for
  # each cluster of logged Bash requests. Below `min_confidence` the cluster
  # is labeled `unsure` and the reviewer decides from its examples.
  bash_feedback: {
    min_confidence: 0.6
    questions: {
      remedy: {
        type: choice
        instructions: "Which change would make agents need the Bash requests in `cluster` less often? `cluster.rule` is the Bash policy rule that decided them, `cluster.outcomes` what happened to them, and `cluster.examples` sample command lines."
        criteria: {
          instruction_gap: "The requests were denied and a Nushell pipeline could do the same work directly, so the agent instructions should give a recipe"
          dedicated_tool: "A dedicated tool already covers the work, such as a Jujutsu, GitHub, or Nix MCP tool, so the instructions should name it"
          needs_bash: "The work genuinely needs Bash, such as a terminal, sudo, or a harness-only feature, so the policy should allow a narrow pattern"
          background_log: "Text tools such as grep, tail, or cat read the log or output of a background run, which belongs in a scratchpad file read from Nushell"
          tighten_allow: "The requests were allowed and ran, but Nushell would have worked, so an allow rule is too broad"
          long_job: "A long workflow command such as a build, publish, or landing ran in the background and should run as a Nushell job"
          tooling_gap: "The Nushell evaluate tool lacks a capability the work needs, which is a tooling problem rather than a policy or instruction change"
        }
      }
    }
  }
  # Claude Code permission dialogs; thresholds and class tiers live in
  # modules/tooling/ai/trust-policy.nuon.
  route: {
    questions: {
      action_class: {
        type: choice
        instructions: "Which kind of action is the agent tool call `tool_name` with arguments `input`, run in `cwd`?"
        criteria: {
          read_only: "Only inspects files, status, logs, history, documentation, or search results and changes nothing"
          local_edit: "Creates or edits files inside a version-controlled working copy, where the change can be undone"
          local_vcs: "A local Jujutsu or Git operation that does not contact a remote, such as describe, new, commit, split, squash, or rebase"
          validation: "Formats, lints, evaluates, tests, or builds without activating or deploying the result"
          publish: "Pushes a topic branch or updates a review, such as publishing a pull request, without changing the main branch"
          deliver: "Lands or merges into the main branch, tags a release, or deploys"
          system_change: "Changes the running system: activation, privileged commands, services, system packages, or files outside a version-controlled working copy"
          external_message: "Sends or changes something other people or external accounts see, such as mail, calendar events, issues, or comments"
          destructive: "Deletes or overwrites data that version control cannot restore"
          other: "Anything else"
        }
      }
      needs_user_intent: {
        type: noul
        instructions: "Deciding whether the tool call `tool_name` with arguments `input` should run requires the user's own preference or intent, rather than facts that repository files, documentation, tool output, or another agent could settle."
        criteria: {
          "true": "The right answer depends on what the user wants, such as scope, naming, trade-offs, timing, or whether to do the task at all"
          "false": "The call is a routine step whose correctness is a matter of fact, such as reading, formatting, or validating"
        }
      }
    }
  }
  # `jev classify-task`: quota-advisor's --jev labels for a task description.
  # Explicit labels in the advisor's snapshot override these answers.
  classify_task: {
    questions: {
      difficulty: {
        type: choice
        instructions: "How difficult is the task in `task`?"
        criteria: {
          low: "Routine, bounded task with an easy deterministic check"
          medium: "Moderate investigation or implementation with several decisions"
          high: "Deep or novel reasoning with substantial uncertainty"
        }
      }
      error_cost: {
        type: choice
        instructions: "What is the cost of an incorrect result for `task`?"
        criteria: {
          low: "A wrong result is quickly noticed and cheap to correct"
          medium: "A wrong result wastes meaningful time or requires review"
          high: "A wrong result risks irreversible changes, sensitive data, or substantial harm"
        }
      }
    }
  }
  # `nixpkgs-watch check`: whether a pull request npr found for a watched
  # package, but which is not titled as that package's own, bears on the
  # workaround. Each pull request is judged once, from its title.
  nixpkgs_watch: {
    # At or above this the pull request is reported and notified.
    min_related: 0.7
    questions: {
      bears_on_workaround: {
        type: noul
        instructions: "The nixpkgs pull request titled `pr.title` could make the workaround in `workaround.reason` for the package `workaround.package` unnecessary, for example by adding, renaming, updating, or fixing that package or the dependency the workaround exists for."
        criteria: {
          "true": "The pull request changes the package itself, a renamed or split attribute of it, or what the workaround works around"
          "false": "The pull request only mentions the package in passing, touches unrelated packages, or is a mass change that leaves it as it was"
        }
      }
    }
  }
  # `jev session-triage`: Jev reads how a Claude Code session ended; code
  # checks what it names against jj, GitHub, and the system profile and
  # decides. Tuned on 166 desktop sessions triaged by hand on 2026-10-16.
  session_triage: {
    # Characters of each message sent; Jev loses accuracy on long state.
    max_user_chars: 800
    max_reply_chars: 2500
    # Recent replies scanned in code for change ids, releases, and PRs.
    recent_replies: 5
    parallel_requests: 6
    # A session that waited on a job this long, with nothing in flight,
    # has seen that job end.
    job_settled_after: 1day
    # A session left waiting on the user this long is stale once
    # everything it names has landed.
    stale_after: 7day
    min_delivery_only: 0.5
    min_activation: 0.7
    # Remaining-work score below which a finished session, or any
    # session that was not interrupted, is archived.
    finished_max_remaining: 2.0
    archive_max_remaining: 1.2
    # At or above this the session is ongoing rather than close-out work.
    ongoing_min_remaining: 3.3
    questions: {
      ending: {
        type: choice
        instructions: "How did the coding-agent session in `session` end? Judge from `session.last_assistant_message`, the agent's final reply, and `session.last_user_message`. `session.stopped_mid_turn` is true when the transcript ends on a user message or tool activity instead of a reply."
        criteria: {
          interrupted: "The session stopped partway through the task: it stopped mid-turn, or the final reply only narrates a step in progress without reporting an outcome"
          waiting_on_job: "The final reply says a build, landing, deployment, or CI run was still running and the agent would report when it finished"
          awaiting_decision: "The final reply asks the user to choose or approve something before work continues, such as whether to land, push, publish, delete, or which option to take"
          awaiting_user_step: "The agent's part is done, and the final reply tells the user to run a command or do something by hand, such as a system switch, activation, deploy, login, restart, review, or account change"
          open_discussion: "An exploration, design proposal, or diagnosis that has not reached a conclusion or decision"
          finished: "The final reply reports the requested work as complete or answers the question; anything it offers beyond that is optional"
        }
      }
      delivery_only: {
        type: noul
        instructions: "In the session in `session`, all the changes the agent set out to make are already written, and the only remaining steps are delivering them: publishing a branch, landing or merging it, opening or merging a pull request, activating, or switching the system."
        criteria: {
          "true": "Nothing remains to write or decide about the content; only publish, land, merge, activate, or switch steps are left, or nothing at all"
          "false": "Some code, configuration, documentation, investigation, or a decision about the content itself is still unfinished"
        }
      }
      activation_step: {
        type: noul
        instructions: "The final reply in `session.last_assistant_message` leaves the user a step that only applies already-delivered configuration to a running machine or app: a NixOS or system switch, nixos-rebuild, home-activate, logging out and back in, or restarting an application."
        criteria: {
          "true": "The step the user is left with is applying, switching, activating, re-logging in, or restarting"
          "false": "The final reply leaves no such step, or the remaining step is something else, such as landing, merging, reviewing, deciding, or writing code"
        }
      }
      remaining_work: {
        type: score
        instructions: "How much work remains for the task in the session in `session`, judging from its final reply?"
        criteria: [
          "Nothing remains"
          "Only optional follow-ups the agent offered"
          "A single command, click, or yes/no answer"
          "A small task of a few steps"
          "Substantial unfinished work"
        ]
      }
    }
  }
  # `jev distill-candidates`: which things the user said in a session are
  # worth offering to /iwe:distill. Code keeps `keep_kinds` at or above
  # `min_durable`; the user still chooses what is written.
  distill: {
    max_user_chars: 1500
    max_reply_chars: 1500
    parallel_requests: 6
    min_durable: 0.6
    keep_kinds: [rule correction preference decision fact]
    questions: {
      kind: {
        type: choice
        instructions: "What kind of statement is the user's message in `message`? `previous_reply` is the agent reply it answers, for context only; judge the user's words."
        criteria: {
          rule: "States how agents should always or never work, such as a convention, policy, or requirement"
          correction: "Corrects something the agent did or claimed, and says what is right instead"
          preference: "Expresses a lasting taste or choice, such as a tool, style, layout, or way of being informed"
          decision: "Settles a design or project choice between alternatives"
          fact: "Gives a fact about the user's machines, accounts, projects, or environment that the agent could not look up"
          task_request: "Asks for a specific piece of work or answer in this session"
          acknowledgement: "Approves, thanks, or tells the agent to continue, with nothing else to keep"
          other: "Anything else"
        }
      }
      durable: {
        type: noul
        instructions: "What the user says in `message` would still matter to a future agent session weeks later or in a different repository."
        criteria: {
          "true": "It is a standing rule, preference, correction, decision, or fact that outlives this task"
          "false": "It only concerns the current task, a one-off detail, or chat"
        }
      }
    }
  }
}
