layout {
    // Every tab, including ones opened later with Ctrl+t n, keeps the bars.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    // Main work area: a wide primary shell beside the JJ revision UI.
    tab name="work" focus=true {
        pane split_direction="vertical" {
            pane name="main" size="60%" focus=true
            pane name="jjui" command="jjui"
        }
    }

    // Pull requests, issues, and checks.
    tab name="gh dash" {
        pane name="gh dash" command="gh" {
            args "dash"
        }
    }

    tab name="scratch"
}
