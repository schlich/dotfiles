layout {
    tab name="edit" focus=true {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane name="shell"
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="checks" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane name="shell"
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="jj" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane name="shell"
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
}
