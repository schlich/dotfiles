# Claude Code Bash policy, read by scripts/prefer-nushell-bash.nu.
#
# Foreground Bash is denied unless a rule below allows it; the agent is sent
# to the Nushell MCP tool instead. Background runs (`run_in_background`) are
# allowed, except for the long_jobs programs, which run as Nushell jobs in
# the evaluate tool with a log in the scratchpad.
# Calls this policy does not deny go to Jev (`jev bash-guard`), which denies
# them or leaves them to the normal permission prompt; denied calls never
# reach Jev.
# Monitor commands run through Bash, so they are judged as foreground Bash
# calls, except for the monitor_allow commands, which run without a prompt.
#
# Every request is logged; review the log with `claude-bash-audit report`
# and the bash-feedback skill, then tune this file or the agent instructions.
{
  # Stage programs denied even in the background, with a Nushell hint.
  text_tools: [
    awk cat cut egrep fd fgrep find grep head jq less ls more rg sed sort tail tr uniq wc yq
  ]

  # Stage programs denied even in the background, with a Nushell job hint:
  # long workflow commands such as `ci land` and `nix build`.
  long_jobs: [ci nix]

  # Regexes matched against the whole command. `why` records the use case;
  # `skip_text_tools` also exempts the command from the text_tools check.
  allow: [
    {
      pattern: '(^|[;&|][&|]?|\n)\s*(jev\b|nu\s+(/home/schlich/dotfiles-jev|~/dotfiles-jev)/jev/jev\.nu\b)'
      why: "Personal Jev automation, not a raw shell pipeline"
      skip_text_tools: true
    }
    {
      # The heredoc's prose lines would otherwise read as pipeline stages.
      pattern: '^\s*iwe\s'
      why: "IWE memory writes pass a note to `iwe create --content -` as a heredoc"
      skip_text_tools: true
    }
    {
      pattern: '^\s*sudo\s'
      why: "Privileged commands need Claude Code's approval prompt; run as `sudo -A`, they then also pass sudoplz's approval dialog"
    }
  ]

  # Monitor commands allowed outright: regexes matched against the whole
  # command, which must leave Bash nothing to expand, redirect, or chain.
  monitor_allow: [
    {
      # watch-job with plain or quoted arguments, after at most one `# title`
      # line; `\x27` is a single quote.
      pattern: '^([ \t]*#[^\n]*\n)?[ \t]*watch-job([ \t]+([A-Za-z0-9_./~+@%:,=-]+|\x27[^\x27\n]*\x27|"[^"$`\\!\n]*"))+[ \t]*\n?$'
      why: "watch-job follows a job-log job, which the Shell conventions run under a Monitor"
    }
  ]
}
