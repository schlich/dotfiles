{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:

let
  system = pkgs.stdenv.hostPlatform.system;
  workflowSource = ../../../../plugins/workflow-status;

  # The programs the workflow-status plugin runs, by store path, so it reads
  # the same Git and JJ configuration as the shell whatever PATH the TUI
  # inherits. The checked-in tools.ts names them bare, for a checkout.
  workflowTools = pkgs.writeText "workflow-status-tools.ts" ''
    // Generated by modules/tooling/ai/shared/plugins.nix.
    export default ${
      builtins.toJSON {
        git = "${config.programs.git.package}/bin/git";
        jj = "${config.programs.jujutsu.package}/bin/jj";
        gh = "${pkgs.gh}/bin/gh";
        xs = "${inputs.xs.packages.${system}.default}/bin/xs";
        luvus = "${
          import ../../../programs/multiplexers/luvus-package.nix { inherit inputs lib pkgs; }
        }/bin/luvus";
        xdgOpen = "${pkgs.xdg-utils}/bin/xdg-open";
        wlCopy = "${pkgs.wl-clipboard}/bin/wl-copy";
      }
    }

    // The repository nixos-switch-main applies (modules/nixos/fleet/system-switch.nix).
    export const switchRepository = "schlich/dotfiles"
  '';

  # A TUI plugin is a directory with a tui entry. OpenCode's server also scans
  # the plugin directory and skips a directory with no server entry.
  workflowStatus = pkgs.runCommandLocal "opencode-workflow-status" { } ''
    mkdir $out
    cp ${workflowSource}/collect.ts ${workflowSource}/model.ts ${workflowSource}/tui.tsx $out/
    cp ${workflowTools} $out/tools.ts
  '';
in
{
  dotfiles.tooling.opencodeConfig = {
    jj-main-changeset = {
      source = ../../../../plugins/jj-main-changeset.ts;
      target = "jj-main-changeset.ts";
    };
    jj-shell-environment = {
      source = ../../../../plugins/jj-shell-environment.ts;
      target = "jj-shell-environment.ts";
    };
    # Version control, CI, background jobs, luvus tasks, and the NixOS switch
    # in the sidebar and the workflow panel (plugins/workflow-status).
    workflow-status = {
      source = workflowStatus;
      target = "workflow-status";
    };
  };

  # The plugin's parsing and summaries, and that every source transpiles.
  dotfiles.tooling.checks.opencode-workflow-status =
    pkgs.runCommandLocal "opencode-workflow-status-check" { nativeBuildInputs = [ pkgs.bun ]; }
      ''
        export HOME="$TMPDIR/home"
        mkdir -p "$HOME"
        cp -r ${workflowSource} plugin
        chmod -R u+w plugin
        cd plugin
        for file in collect.ts model.ts tools.ts tui.tsx ${workflowTools}; do
          bun build --no-bundle "$file" --outdir "$TMPDIR/transpiled" > /dev/null
        done
        bun test ./model.test.ts
        touch "$out"
      '';
}
